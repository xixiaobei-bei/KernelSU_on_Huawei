+			info->err = -ENOMEM;
+			goto out_copy_to_user;
+		}
+	}
+
+	write_seqlock(&susfs_fake_cmdline_or_bootconfig_seqlock);
+	strncpy(fake_cmdline_or_bootconfig,
+			info->fake_cmdline_or_bootconfig,
+			SUSFS_FAKE_CMDLINE_OR_BOOTCONFIG_SIZE-1);
